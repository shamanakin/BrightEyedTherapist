<?php
/**
 * Local Configuration Template for Bright Eyed Therapist
 * 
 * Copy this file to config.local.php and fill in your real credentials.
 * The config.local.php file is gitignored and will not be committed.
 */

// =============================================================================
// DATABASE CONFIGURATION
// =============================================================================
// Get these from your hosting provider (DreamHost, etc.)
define('DB_HOST', 'mysql.yourdomain.com');
define('DB_NAME', 'your_database_name');
define('DB_USER', 'your_database_user');
define('DB_PASS', 'your_database_password');
define('DB_CHARSET', 'utf8mb4');

// =============================================================================
// STRIPE CONFIGURATION
// =============================================================================
// Get these from https://dashboard.stripe.com/apikeys
// Use sk_test_xxx and pk_test_xxx for development
// Use sk_live_xxx and pk_live_xxx for production
define('STRIPE_SECRET_KEY', 'sk_live_xxxxxxxxxxxxxxxxxxxx');
define('STRIPE_PUBLISHABLE_KEY', 'pk_live_xxxxxxxxxxxxxxxxxxxx');

// Get this from Stripe Dashboard > Developers > Webhooks > Signing secret
define('STRIPE_WEBHOOK_SECRET', 'whsec_xxxxxxxxxxxxxxxxxxxx');

// Create these in Stripe Dashboard > Products
define('STRIPE_PRICE_EARLY_ACCESS', 'price_xxxxxxxxxxxxxxxxxxxx');
define('STRIPE_PRICE_VIP', 'price_xxxxxxxxxxxxxxxxxxxx'); // Future $20/mo plan

// =============================================================================
// EMAIL CONFIGURATION (SendGrid)
// =============================================================================
// Get your API key from https://app.sendgrid.com/settings/api_keys
define('EMAIL_API_KEY', 'SG.xxxxxxxxxxxxxxxxxxxx');
define('EMAIL_FROM', 'support@yourdomain.com');
define('EMAIL_FROM_NAME', 'Your App Name');

// =============================================================================
// SITE CONFIGURATION
// =============================================================================
define('SITE_URL', 'https://yourdomain.com');
define('TRIAL_DAYS', 14);

// =============================================================================
// SECURITY
// =============================================================================
// Generate a random 64-character hex string for JWT_SECRET
// You can use: openssl rand -hex 32 (on Linux/Mac)
// Or: [System.BitConverter]::ToString((1..32 | ForEach-Object { Get-Random -Max 256 })).Replace('-','').ToLower() (PowerShell)
define('JWT_SECRET', 'generate_a_random_64_character_hex_string_here');
define('SESSION_LIFETIME', 86400 * 30); // 30 days

// Rate Limiting (brute force protection)
define('RATE_LIMIT_LOGIN_ATTEMPTS', 5);       // Max failed login attempts per email
define('RATE_LIMIT_LOGIN_WINDOW', 900);       // 15 minute window
define('RATE_LIMIT_REGISTER_ATTEMPTS', 3);    // Max registrations per IP
define('RATE_LIMIT_REGISTER_WINDOW', 3600);   // 1 hour window

// =============================================================================
// TIMEZONE
// =============================================================================
date_default_timezone_set('America/New_York');

// =============================================================================
// ERROR REPORTING
// =============================================================================
// Production: Hide errors from users, log to file
error_reporting(E_ALL);
ini_set('display_errors', '0');
ini_set('log_errors', '1');
ini_set('error_log', __DIR__ . '/logs/php-errors.log');

// =============================================================================
// CORS SETTINGS
// =============================================================================
define('ALLOWED_ORIGINS', [
    'https://yourdomain.com',
    'https://www.yourdomain.com',
    'http://localhost:3000' // For local development
]);

// =============================================================================
// ADMIN EMAIL WHITELIST
// =============================================================================
// These email addresses get admin access to /admin/ dashboard
define('ADMIN_EMAILS', [
    'admin@yourdomain.com',
    'developer@yourdomain.com'
]);






